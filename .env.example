# Copy this file to ".env" on the server and fill in the values.

# ── Database (SQLite file, path relative to the prisma/ folder) ──
DATABASE_URL="file:./fungibd.db"

# ── Security: a long random secret (at least 32 characters). Generate one with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ── Public website address (used in email links). No trailing slash.
SITE_URL="https://fungibd.com"

# ── First owner login for /admin (created by the seed script; change the password after first login)
ADMIN_EMAIL="admin@fungibd.com"
ADMIN_PASSWORD="choose-a-strong-password"

# ── Email (SMTP). Leave SMTP_HOST empty to only log emails (nothing is sent).
# Zoho Mail:  smtp.zoho.com, port 465, SMTP_SECURE=true
# Gmail:      smtp.gmail.com, port 465, SMTP_SECURE=true, use an App Password
# Brevo:      smtp-relay.brevo.com, port 587, SMTP_SECURE=false
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FungiBd <orders@fungibd.com>"

# ── Where uploaded product photos are stored (outside the code, keep it backed up)
UPLOAD_DIR="./uploads"

TZ="Asia/Dhaka"
