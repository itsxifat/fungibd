{
  "name": "fungibd",
  "version": "1.0.0",
  "private": true,
  "description": "FungiBd — farm-fresh mushroom store and farm management system",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "backup": "tsx scripts/backup.ts",
    "postinstall": "prisma generate",
    "db:demo": "tsx prisma/seed.ts --demo",
    "db:fresh": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.0.0",
    "jspdf": "^2.5.2",
    "leaflet": "1.9.4",
    "lucide-react": "^0.511.0",
    "motion": "^12.23.0",
    "next": "15.5.29",
    "nodemailer": "^6.10.0",
    "qrcode": "1.5.4",
    "react": "~19.1.0",
    "react-dom": "~19.1.0",
    "react-leaflet": "5.0.0",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.0",
    "tailwind-merge": "^3.0.0",
    "zod": "3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/qrcode": "^1.5.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
